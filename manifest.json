{
  "manifest_version": 3,
  "name": "deepseek ui",
  "version": "0.3.26",
  "description": "把 DeepSeek 网页版重排为中文文档工作台：阅读、搜索、导出和本地收藏。纯本地增强，保留原生表单发送链路。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["rich-model.js", "queue.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "deepseek ui",
    "default_popup": "popup.html"
  }
}
