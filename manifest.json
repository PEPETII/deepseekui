{
  "manifest_version": 3,
  "name": "DeepSeek 文档化阅读",
  "version": "0.3.15",
  "description": "把 DeepSeek 网页版重排为中文文档工作台：阅读、搜索、导出和本地收藏。纯本地增强，不触碰登录与发送链路。",
  "minimum_chrome_version": "109",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "文档化开关",
    "default_popup": "popup.html"
  }
}
